# ==============================================================================
# AnyTrader Environment Variables Template (.env.example)
# Copy to `.env` for local development. NEVER commit real `.env` files or secrets.
# ==============================================================================

# --- Core Server & Networking ---
NODE_ENV="development"
PORT="3000"
APP_URL="https://your-app-domain.com"
ALLOWED_ORIGINS="https://your-app-domain.com,https://www.your-app-domain.com"
# Set implicitly by Cloud Run in production (documented for reference; leave unset locally):
# K_SERVICE=
# K_REVISION=
# HOSTNAME=

# --- Frontend / Vite Build-Time Public Variables (Bundled into Client) ---
VITE_API_URL="https://your-app-domain.com"
VITE_APP_URL="https://your-app-domain.com"
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_replace_with_stripe_publishable_key"
VITE_GOOGLE_MAPS_API_KEY="replace_with_restricted_web_maps_api_key"
VITE_GOOGLE_MAPS_API_KEY_ANDROID="replace_with_restricted_android_maps_api_key"
VITE_RECAPTCHA_SITE_KEY="replace_with_recaptcha_v3_site_key"

# --- Gemini AI (Server-Side Only — Never expose to client) ---
GEMINI_API_KEY="replace_with_gemini_api_key"

# --- Stripe Payments, Connect & Webhooks (Server-Side Only) ---
STRIPE_SECRET_KEY="sk_test_replace_with_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_replace_with_stripe_webhook_signing_secret"
# Optional legacy price overrides (server uses src/server/pricingCatalog.ts + Firestore dynamic config)
STRIPE_PRICE_ID_STARTER=""
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_ENTERPRISE=""

# --- Firebase & Local Emulator Configuration ---
# Core Firebase project/app/database IDs are committed in firebase-applet-config.json.
# Server Admin SDK authenticates via Google Application Default Credentials (ADC / Workload Identity).
FIREBASE_STORAGE_BUCKET="anytradercombined.firebasestorage.app"
# Uncomment only when running against local Firebase emulators:
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8088"
# FIREBASE_STORAGE_EMULATOR_HOST="127.0.0.1:9199"

# --- Twilio SMS Notifications (Server-Side Optional; Mocks if unset in dev) ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER="AnyTrader"

# --- Security, Auth, Cron & Runtime Guard Flags ---
JWT_SECRET="replace_with_high_entropy_random_secret_min_32_chars"
CRON_SECRET="replace_with_high_entropy_shared_cron_secret"
ADMIN_ALERT_EMAIL="security-alerts@your-app-domain.com"
DISABLE_HMR="true"
DISABLE_IN_PROCESS_CRON="false"
STRICT_PREFLIGHT_EXIT="false"
# MUST remain "false" in production:
ALLOW_DEGRADED_AUTH="false"
ALLOW_MOCK_PAYMENTS="false"
